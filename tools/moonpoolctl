#!/usr/bin/env bash
# Moonpool: Unified Subsea Robotics Command-Line Interface Driver
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

show_help() {
    cat <<EOF
Moonpool Subsea Intervention Executive Driver (moonpoolctl)

Usage:
  ./tools/moonpoolctl <command> [options]

Commands:
  build       Compile C17 fastpath library and bootstrap OpenEuphoria
  test        Execute complete test matrix (linters, unit, fastpath, integration)
  test-unit   Run Euphoria core unit tests
  bench       Run empirical throughput and latency benchmarks
  sim         Launch subsea pipeline survey simulation
  lint        Verify zero em-dash typography invariant
  clean       Remove compilation and run artifacts
  help        Display this help message
EOF
}

COMMAND="${1:-help}"

case "${COMMAND}" in
    build)
        echo ">> Building Moonpool executive..."
        make -C "${REPO_DIR}" all
        ;;
    test)
        echo ">> Executing complete verification matrix..."
        make -C "${REPO_DIR}" test
        ;;
    test-unit)
        echo ">> Running Euphoria unit test suites..."
        make -C "${REPO_DIR}" test-unit
        ;;
    bench)
        echo ">> Executing performance and latency benchmarks..."
        make -C "${REPO_DIR}" bench
        ;;
    sim)
        echo ">> Launching autonomous subsea intervention simulation..."
        make -C "${REPO_DIR}" sim
        ;;
    lint)
        echo ">> Running zero em-dash typography verification..."
        make -C "${REPO_DIR}" lint
        ;;
    clean)
        echo ">> Cleaning build artifacts..."
        make -C "${REPO_DIR}" clean
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: ${COMMAND}"
        show_help
        exit 1
        ;;
esac
